{
  "version": 2,
  "name": "pms-diagnostics",
  "buildCommand": "",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/cron-telemetry",
      "schedule": "* * * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/telegram",
      "dest": "/api/telegram.js"
    },
    {
      "src": "/api/setup-webhook",
      "dest": "/api/setup-webhook.js"
    },
    {
      "src": "/api/cron-telemetry",
      "dest": "/api/cron-telemetry.js"
    },
    {
      "src": "/api/telegram-broadcast",
      "dest": "/api/telegram-broadcast.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

